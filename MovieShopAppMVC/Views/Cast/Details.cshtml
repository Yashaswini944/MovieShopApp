@model ApplicationCore.Models.CastDetailsModel

<div class="container mt-4">

    <div class="row">
        <div style="width: 80px; height: 80px; overflow: hidden;">
            <img id="castMainImage" src="@Model.ProfilePath" style="width: 100%; height: 100%; object-fit: cover;" />
        </div>

        <div class="col-md-8">
            <h2>@Model.Name</h2>
            <p><strong>Gender:</strong> @Model.Gender</p>
            <p><a href="@Model.TmdbUrl" target="_blank">TMDB Profile</a></p>
        </div>
    </div>

    <hr />

    <h4>Movies</h4>
    <div class="row">
        @foreach (var movie in Model.Movies)
        {
            <div class="col-md-3 mb-4">
                @await Html.PartialAsync("_MovieCard", new ApplicationCore.Models.MovieCardModel
                {
                    Id = movie.MovieId,
                    Title = movie.Title,
                    PosterUrl = movie.PosterUrl
                })
            </div>
        }
    </div>

</div>

<!-- MODAL MOVED OUTSIDE THE ROW — THIS FIXES GENRE DROPDOWN -->
<div class="modal fade" id="castModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content p-3">
            <div class="modal-header">
                <h5 class="modal-title" id="castName"></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <div class="text-center mb-3">
                    <img id="castImage" style="width:120px; height:120px; object-fit:cover; border-radius:8px;" />
                </div>

                <h5>Movies Acted In</h5>
                <div id="castMovies" class="row g-3 mt-2"></div>
            </div>
        </div>
    </div>
</div>

<script>
    function loadCastDetails(castId, castName, castImage) {
        document.getElementById("castName").innerText = castName;
        document.getElementById("castImage").src = castImage;

        document.getElementById("castMovies").innerHTML = "";

        fetch(`/Cast/GetMovies/${castId}`)
            .then(response => response.json())
            .then(movies => {
                movies.forEach(movie => {
                    document.getElementById("castMovies").innerHTML += `
                        <div class="col-3">
                            <a href="/Movies/Details/${movie.id}">
                                <img src="${movie.posterUrl}" style="width:100%; height:180px; object-fit:cover;" />
                                <p class="mt-2">${movie.title}</p>
                            </a>
                        </div>
                    `;
                });
            });

        var modal = new bootstrap.Modal(document.getElementById('castModal'));
        modal.show();
    }
</script>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        var img = document.getElementById("castMainImage");

        if (img) {
            img.style.cursor = "pointer";

            img.addEventListener("click", function () {
                loadCastDetails(@Model.Id, '@Model.Name', '@Model.ProfilePath');
            });
        }
    });
</script>
