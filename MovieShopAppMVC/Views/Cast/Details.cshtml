@model ApplicationCore.Models.CastDetailsModel

<div class="container mt-4">

    <div class="row">
        <div class="col-md-4">
            <img src="@Model.ProfilePath" class="img-fluid rounded" />
        </div>

        <div class="col-md-8">
            <h2>@Model.Name</h2>
            <p><strong>Gender:</strong> @Model.Gender</p>
            <p><a href="@Model.TmdbUrl" target="_blank">TMDB Profile</a></p>
        </div>
    </div>

    <hr />

    <h4>Movies</h4>
    <div class="row">
        @foreach (var movie in Model.Movies)
        {
            <div class="col-md-3 mb-4">
                @await Html.PartialAsync("_MovieCard", new ApplicationCore.Models.MovieCardModel
                {
                    Id = movie.MovieId,
                    Title = movie.Title,
                    PosterUrl = movie.PosterUrl
                })
            </div>
        }
    </div>

</div>
