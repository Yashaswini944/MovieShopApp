@model ApplicationCore.Models.PurchaseRequestModel

<div class="container mt-4">
    <h2>Purchase Movie</h2>

    <div class="row">
        <div class="col-md-4">
            <img src="@Model.PosterUrl" class="img-fluid rounded" />
        </div>

        <div class="col-md-8">
            <h3>@Model.Title</h3>
            <p><strong>Price:</strong> $@Model.TotalPrice</p>

            <form asp-action="Purchase" method="post">
                <input type="hidden" asp-for="MovieId" />
                <input type="hidden" asp-for="UserId" />
                <input type="hidden" asp-for="TotalPrice" />

                <button type="submit" class="btn btn-success btn-lg mt-3">
                    Confirm Purchase
                </button>
            </form>
        </div>
    </div>
</div>
