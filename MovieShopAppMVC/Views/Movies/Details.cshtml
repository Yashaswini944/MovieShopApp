@model ApplicationCore.Models.MovieDetailsModel

<div class="container mt-4">

    <div class="row">
        <div class="col-md-4">
            <img src="@Model.PosterUrl" class="img-fluid rounded" />
        </div>

        <div class="col-md-8">
            <h2>@Model.Title</h2>
            <p class="text-muted">@Model.Tagline</p>

            <p><strong>Release Date:</strong> @Model.ReleaseDate?.ToShortDateString()</p>
            <p><strong>Runtime:</strong> @Model.RunTime mins</p>
            <p><strong>Rating:</strong> @Model.Rating</p>

            <p>@Model.Overview</p>

            <h5>Genres</h5>
            <p>
                @foreach (var g in Model.Genres)
                {
                    <span class="badge bg-primary me-1">@g</span>
                }
            </p>

            <h5>Trailers</h5>
            <ul>
                @foreach (var t in Model.Trailers)
                {
                    <li><a href="@t.TrailerUrl" target="_blank">@t.Name</a></li>
                }
            </ul>

            <!--  PURCHASE + REVIEW BUTTONS  -->
            <div class="mt-4 d-flex gap-3">

                <a class="btn btn-success btn-lg"
                       href="/User/Purchase?movieId=@Model.Id">
                    Purchase
                </a>

                <a class="btn btn-primary btn-lg"
                       href="/User/AddReview?movieId=@Model.Id">
                    Review
                </a>

            </div>
            <!--  END BUTTON SECTION  -->

        </div>
    </div>

    <hr />

    <h4>Cast</h4>
    <div class="row">
        @foreach (var cast in Model.Casts)
        {
            <div class="col-md-3 text-center mb-4">

                <!--  UPDATED CAST IMAGE (CLICKABLE)  -->
                <img src="@cast.ProfilePath"
                     class="img-fluid rounded cast-click"
                     data-cast-id="@cast.CastId"
                     data-cast-name="@cast.Name"
                     data-cast-img="@cast.ProfilePath" />

                <h6 class="mt-2">@cast.Name</h6>
                <p class="text-muted">@cast.Character</p>
            </div>
        }
    </div>

</div>

<!--CAST POPUP MODAL-->
<div class="modal fade" id="castModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content p-3">
            <div class="modal-header">
                <h5 class="modal-title" id="castName"></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <div class="text-center mb-3">
                    <img id="castImage" style="width:120px; height:120px; object-fit:cover; border-radius:8px;" />
                </div>

                <h5>Movies Acted In</h5>
                <div id="castMovies" class="row g-3 mt-2"></div>
            </div>
        </div>
    </div>
</div>

<!--  CAST CLICK SCRIPT -->
<script>
    document.addEventListener("DOMContentLoaded", function () {

        document.querySelectorAll(".cast-click").forEach(img => {

            img.style.cursor = "pointer";

            img.addEventListener("click", function () {

                const castId = this.dataset.castId;
                const castName = this.dataset.castName;
                const castImg = this.dataset.castImg;

                document.getElementById("castName").innerText = castName;
                document.getElementById("castImage").src = castImg;
                document.getElementById("castMovies").innerHTML = "";

                fetch(`/Cast/GetMovies/${castId}`)
                    .then(res => res.json())
                    .then(movies => {
                        movies.forEach(m => {
                            document.getElementById("castMovies").innerHTML += `
                                <div class="col-3">
                                    <a href="/Movies/Details/${m.movieId}">
                                        <img src="${m.posterUrl}" style="width:100%; height:180px; object-fit:cover;" />
                                        <p class="mt-2">${m.title}</p>
                                    </a>
                                </div>
                            `;
                        });
                    });

                new bootstrap.Modal(document.getElementById("castModal")).show();
            });
        });
    });
</script>
