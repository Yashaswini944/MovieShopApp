@model ApplicationCore.Models.MovieCardModel

<div class="card shadow-sm">
    <img src="@Model.PosterUrl" class="card-img-top" />

    <div class="card-body">
        <h6 class="card-title">@Model.Title</h6>

        <a class="btn btn-primary btn-sm"
               href="/Movies/Details/@Model.Id">
            View Details
        </a>
    </div>
</div>
