@model ApplicationCore.Models.MovieCardModel

<div class="card shadow-sm h-100" style="height: 380px;">
    <div style="height: 260px; overflow: hidden;">
        <img src="@Model.PosterUrl" class="card-img-top" style="height: 100%; width: 100%; object-fit: cover;" />
    </div>

    <div class="card-body d-flex flex-column">
        <h6 class="card-title flex-grow-1">@Model.Title</h6>

        <a class="btn btn-primary btn-sm mt-auto"
               href="/Movies/Details/@Model.Id">
            View Details
        </a>
    </div>
</div>
