@model IEnumerable<ApplicationCore.Models.GenreModel>

<li class="nav-item dropdown">
    <a class="nav-link dropdown-toggle text-dark" href="#" id="genreDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
        Genres
    </a>
    <ul class="dropdown-menu" aria-labelledby="genreDropdown">
        @foreach (var genre in Model)
        {
            <li>
                <a class="dropdown-item" href="/Movies/MoviesByGenre/@genre.Id">@genre.Name</a>
            </li>
        }
    </ul>
</li>
